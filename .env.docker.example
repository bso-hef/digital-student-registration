# Environment Variables for Docker Deployment
# Copy this file to .env and update with your actual values
# NEVER commit .env file with real credentials to version control!

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
# Options: development, production, test
NODE_ENV=production

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port]/database[?options]
# For Docker: Use service name 'mongo' as host
MONGODB_URI=mongodb://admin:your_secure_mongodb_password@mongo:27017/digital-student-onboarding?authSource=admin

# MongoDB root credentials (used by docker-compose)
MONGO_USER=admin
MONGO_PASSWORD=your_secure_mongodb_password

# =============================================================================
# NEXTAUTH CONFIGURATION (Authentication)
# =============================================================================
# Full URL where your application is hosted (include https://)
# Examples:
#   Development: https://localhost:3000
#   Production: https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# Secret key for JWT signing (REQUIRED - must be at least 32 characters)
# Generate a secure random string:
#   Linux/Mac: openssl rand -base64 48
#   Node.js: require('crypto').randomBytes(48).toString('base64')
# IMPORTANT: Use a different secret for production!
NEXTAUTH_SECRET=REPLACE_THIS_WITH_A_SECURE_RANDOM_STRING_AT_LEAST_64_CHARS_FOR_PRODUCTION

# =============================================================================
# APPLICATION URLs
# =============================================================================
# Public-facing API URL (used by client-side code)
# Should match NEXTAUTH_URL in most cases
NEXT_PUBLIC_API_URL=https://your-domain.com
QR_CODE_BASE_URL=https://your-domain.com

# =============================================================================
# APPLICATION METADATA
# =============================================================================
# Application version (should match package.json version)
APP_VERSION=2.1.0

# Application name
APP_NAME=Digital Student Registration

# Docker image name (used by docker-compose)
DOCKER_IMAGE=dsr-app

# These are passed to the container as environment variables
NEXT_PUBLIC_VERSION=2.1.0
NEXT_PUBLIC_NAME=Digital Student Registration

# =============================================================================
# MONGO EXPRESS (Development Only - Database Web UI)
# =============================================================================
# Username and password for Mongo Express web interface
# Only used in development docker-compose.yml
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=pass

# =============================================================================
# OPTIONAL: EMAIL CONFIGURATION (Future Feature)
# =============================================================================
# SMTP settings for email notifications (not yet implemented)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# OPTIONAL: SMS CONFIGURATION (Future Feature)
# =============================================================================
# SMS provider credentials (not yet implemented)
# SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=your-account-sid
# SMS_AUTH_TOKEN=your-auth-token
# SMS_FROM_NUMBER=+1234567890

# =============================================================================
# OPTIONAL: ANALYTICS (Future Feature)
# =============================================================================
# Analytics tracking (not yet implemented)
# ANALYTICS_ID=your-analytics-id
# ANALYTICS_ENABLED=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Node.js options (useful for large builds or high memory usage)
# NODE_OPTIONS=--max-old-space-size=4096

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 1. NEVER use default passwords in production
# 2. Generate strong random passwords (20+ characters)
# 3. Keep .env file secure and never commit it to Git
# 4. Use different credentials for dev/staging/production
# 5. Rotate secrets regularly
# 6. Use environment-specific .env files:
#    - .env.development (for local development)
#    - .env.production (for production deployment)
# 7. Consider using secret management tools for production:
#    - Docker Secrets
#    - Kubernetes Secrets
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault

# =============================================================================
# DOCKER-SPECIFIC NOTES
# =============================================================================
# - Use 'mongo' as the MongoDB host (Docker service name)
# - Ports in MONGODB_URI should match container internal ports
# - External ports are mapped in docker-compose.yml
# - For production, bind ports to 127.0.0.1 and use reverse proxy
