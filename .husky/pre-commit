#!/usr/bin/env sh
# Pre-commit runs two fast checks on every commit:
#   1. `lint-staged` — auto-formats (Prettier) and lints (ESLint) just the
#      staged files. Fast, because it only touches what you changed.
#   2. `yarn test:ts` — a full TypeScript typecheck. Catches cross-file
#      regressions lint-staged can't see (a broken import after a rename, a
#      changed type that breaks a consumer elsewhere).
#
# The full Vitest suite is intentionally NOT run here — it runs on pre-push
# instead, so day-to-day commits stay snappy. Run `yarn test:unit` yourself
# whenever you want the full signal.
#
# Bypass for genuine WIP-on-your-own-branch emergencies:
#   git commit --no-verify

set -e

yarn lint-staged
yarn test:ts
