NODE_ENV=production
APP_NAME=Digital Student Registration
APP_VERSION=2.1.0

# ============================================
# Port Configuration
# ============================================
# APP_PORT: External host port (what port to access on your machine/server)
# Note: The application ALWAYS runs on port 3000 internally in the Docker container
# Docker port mapping: APP_PORT:3000 (host_port:container_port)
#
# Examples:
#   APP_PORT=3000  → Access at http://localhost:3000 (mapped as 3000:3000)
#   APP_PORT=8080  → Access at http://localhost:8080 (mapped as 8080:3000)
#   APP_PORT=80    → Access at http://localhost:80 (mapped as 80:3000, requires sudo/admin)
APP_PORT=3000

# Docker Image Configuration
# Used by docker-compose to pull the correct image
DOCKER_IMAGE=dsr-app

# ============================================
# Application URLs - CRITICAL FOR PRODUCTION!
# ============================================
# QR_CODE_BASE_URL is read at container runtime and is used for QR codes/PDFs.
# Changing it requires recreating the app container, but not rebuilding the image.
#
# For local development:
# NEXT_PUBLIC_APP_URL=https://localhost:3000
# NEXT_PUBLIC_API_URL=https://localhost:3000
# QR_CODE_BASE_URL=https://localhost:3000
# NEXTAUTH_URL=https://localhost:3000
#
# For production, REPLACE with your actual domain:
NEXT_PUBLIC_DOMAIN=your-school-domain.com
NEXT_PUBLIC_APP_URL="http://${NEXT_PUBLIC_DOMAIN}"
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_APP_URL}
QR_CODE_BASE_URL=${NEXT_PUBLIC_APP_URL}
NEXTAUTH_URL=${NEXT_PUBLIC_APP_URL}
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,schulanmeldung.schtt.de

MONGODB_URI=mongodb://localhost:27017/digital-student-registration
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME
MONGO_DB=digital-student-registration

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME

NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

NEXT_TELEMETRY_DISABLED=1
