# Caddyfile for Local Development
# Digital Student Registration System
#
# Configured for localhost with HTTPS (self-signed certificate)

{
    # Global options for local development
    # Disable admin API
    admin off

    # Local development settings
    local_certs
}

# HTTPS on localhost with self-signed certificate
localhost {
    # Self-signed certificate (generated automatically by Caddy)
    # Browser will show security warning - this is normal for local dev
    tls internal

    # Logging configuration (less verbose for local dev)
    log {
        output stdout
        format console
        level INFO
    }

    # Compression
    encode gzip zstd

    # Security headers (relaxed for local dev)
    header {
        # Remove server header
        -Server

        # Basic security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"

        # HSTS for localhost (short duration for dev)
        Strict-Transport-Security "max-age=3600"
    }

    # Cache static assets
    @static {
        path /_next/static/* /images/* /fonts/* /icons/* *.css *.js *.woff *.woff2 *.ttf *.eot *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp
    }

    header @static {
        Cache-Control "public, max-age=3600"
    }

    # API routes - no caching
    @api {
        path /api/*
    }

    header @api {
        Cache-Control "no-store, no-cache, must-revalidate"
    }

    # Reverse proxy to Next.js application
    reverse_proxy app:3000 {
        # Health check
        health_uri /api/health/live
        health_interval 30s
        health_timeout 10s
        health_status 200

        # Pass client info
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Timeouts (relaxed for local debugging)
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 120s
            write_timeout 120s
        }
    }

    # Custom error handling
    handle_errors {
        respond "Service temporarily unavailable (local dev)" 503
    }
}

# HTTP to HTTPS redirect
http://localhost {
    redir https://localhost{uri} permanent
}
