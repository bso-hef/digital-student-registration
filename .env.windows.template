# ============================================
# Digital Student Registration
# Windows Container Environment Configuration
# ============================================
#
# For Windows Server 2022 or Windows 10/11 Pro
# Requires Docker Desktop in Windows container mode
#
# Usage:
#   copy .env.windows.template .env.windows
#   docker-compose -f docker-compose.windows.yml up -d
#   Or use: .\scripts\start-windows.ps1

# ============================================
# Application Configuration
# ============================================

# Application name
APP_NAME=Digital Student Registration (Windows)

# Application version
APP_VERSION=1.0.0-windows

# Node environment
NODE_ENV=production

# ============================================
# MongoDB Configuration
# ============================================

# MongoDB username
MONGO_USER=admin

# MongoDB password
MONGO_PASSWORD=admin123

# MongoDB database name
MONGO_DB=digital-student-registration

# ============================================
# Redis Configuration
# ============================================

# Redis password
REDIS_PASSWORD=redis123

# ============================================
# NextAuth Configuration
# ============================================

# NextAuth secret for JWT signing (64+ characters)
NEXTAUTH_SECRET=windows-dev-secret-change-in-production-min-64-chars-required

# ============================================
# Windows-Specific Notes
# ============================================
#
# 1. Docker Mode:
#    - Must switch Docker Desktop to "Windows containers"
#    - Right-click Docker tray icon → "Switch to Windows containers"
#
# 2. Prerequisites:
#    - Windows Server 2022 or Windows 10/11 Pro
#    - Hyper-V enabled
#    - Docker Desktop for Windows installed
#
# 3. Enable Hyper-V (if not enabled):
#    PowerShell (as Administrator):
#    Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All
#
# 4. Access Points:
#    - Application:  http://localhost:3000
#    - MongoDB:      mongodb://admin:admin123@localhost:27017
#    - Redis:        redis://localhost:6379 (password: redis123)
#
# 5. MongoDB & Redis:
#    - This setup uses Linux containers via LCOW (platform: linux)
#    - Alternatively, install MongoDB/Redis on Windows host
#    - Connect via: host.docker.internal:27017
#
# 6. LCOW Support:
#    - Linux Containers on Windows
#    - Enable in Docker Desktop: Settings → Experimental → "Use LCOW"
#
# 7. Firewall:
#    - Ensure Windows Firewall allows Docker access
#    - Add rules for ports 3000, 27017, 6379
#    PowerShell (as Administrator):
#    New-NetFirewallRule -DisplayName "Docker DSR App" -Direction Inbound -Protocol TCP -LocalPort 3000 -Action Allow
#    New-NetFirewallRule -DisplayName "Docker MongoDB" -Direction Inbound -Protocol TCP -LocalPort 27017 -Action Allow
#    New-NetFirewallRule -DisplayName "Docker Redis" -Direction Inbound -Protocol TCP -LocalPort 6379 -Action Allow
#
# 8. Commands:
#    - Start:  docker-compose -f docker-compose.windows.yml up -d
#    - Stop:   docker-compose -f docker-compose.windows.yml down
#    - Logs:   docker-compose -f docker-compose.windows.yml logs -f app
#    - Clean:  docker-compose -f docker-compose.windows.yml down -v
#
# 9. Performance:
#    - Windows containers have higher overhead than Linux
#    - Recommended: 4+ CPU cores, 8+ GB RAM
#    - First build takes 10-15 minutes (downloads ~2GB base image)
#
# 10. Security Note:
#     These are DEVELOPMENT credentials only!
#     Never use these in production!
