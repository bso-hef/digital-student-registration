# ============================================
# Digital Student Registration
# Production Environment Configuration
# ============================================
#
# Copy this file to .env.production and configure all values
# The start script will auto-generate secrets if not set
#
# Usage:
#   cp .env.production.template .env.production
#   nano .env.production
#   ./scripts/start.sh

# ============================================
# Domain & SSL Configuration
# ============================================

# Your domain name (REQUIRED)
# DNS must be configured to point to your server
# Example: student-registration.example.com
DOMAIN=your-domain.com

# Email for Let's Encrypt notifications (REQUIRED)
# You will receive certificate expiry notifications here
# Example: admin@example.com
ACME_EMAIL=admin@your-domain.com

# ============================================
# Application Configuration
# ============================================

# Application name (shown in UI)
APP_NAME=Digital Student Registration

# Application version
APP_VERSION=1.0.0

# Node environment (do not change)
NODE_ENV=production

# ============================================
# MongoDB Configuration
# ============================================

# MongoDB username (default: admin)
MONGO_USER=admin

# MongoDB password (REQUIRED)
# Will be auto-generated if not set
# Use a strong password (at least 32 characters)
MONGO_PASSWORD=CHANGE_ME

# MongoDB database name
MONGO_DB=digital-student-registration

# ============================================
# Redis Configuration
# ============================================

# Redis password (REQUIRED)
# Will be auto-generated if not set
# Use a strong password (at least 32 characters)
REDIS_PASSWORD=CHANGE_ME

# ============================================
# NextAuth Configuration
# ============================================

# NextAuth secret for JWT signing (REQUIRED)
# Will be auto-generated if not set
# Must be at least 64 characters
NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ============================================
# Optional Configuration
# ============================================

# Logging level (options: error, warn, info, debug)
# Default: info
# LOG_LEVEL=info

# Enable debug mode (not recommended for production)
# DEBUG=false

# Session expiry (in seconds)
# Default: 86400 (24 hours)
# SESSION_MAX_AGE=86400

# ============================================
# Notes
# ============================================
#
# 1. Domain Setup:
#    - Ensure your domain DNS A record points to your server IP
#    - Allow up to 24 hours for DNS propagation
#    - You can check DNS with: dig +short your-domain.com
#
# 2. Firewall Configuration:
#    - Open port 80 (HTTP) for Let's Encrypt challenges
#    - Open port 443 (HTTPS) for secure traffic
#    - Example (ufw):
#      sudo ufw allow 80/tcp
#      sudo ufw allow 443/tcp
#
# 3. Security Best Practices:
#    - Never commit .env.production to git
#    - Use strong, unique passwords for all services
#    - Regularly backup your MongoDB data
#    - Keep Docker images updated
#
# 4. Secret Generation:
#    The start script will automatically generate secure secrets for:
#    - NEXTAUTH_SECRET (64 characters)
#    - MONGO_PASSWORD (32 characters)
#    - REDIS_PASSWORD (32 characters)
#
#    Or generate manually:
#    openssl rand -base64 64 | tr -d "=+/" | cut -c1-64
#
# 5. Testing:
#    - Use Let's Encrypt staging for testing:
#      Uncomment acme_ca line in Caddyfile
#    - Test DNS: curl -I https://your-domain.com
#    - Test health: curl https://your-domain.com/api/health/live
#
# 6. Backup:
#    - MongoDB: docker exec dsr-mongo mongodump --archive=/tmp/backup.archive --gzip
#    - Redis: docker exec dsr-redis redis-cli SAVE
#    - Copy backups: docker cp dsr-mongo:/tmp/backup.archive ./backups/
#
# 7. Monitoring:
#    - View logs: docker-compose logs -f
#    - Check status: docker-compose ps
#    - Resource usage: docker stats
#
# 8. Support:
#    - Documentation: ./DEPLOYMENT.md
#    - GitHub: https://github.com/bso-hef/digital-student-registration
