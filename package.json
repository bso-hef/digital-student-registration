{
  "name": "digital-student-registration",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Valentin Röhle"
  },
  "scripts": {
    "dev": "next dev --turbopack --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "analyze": "source-map-explorer 'build/static/js/*.js/ts/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "test": "vitest",
    "test:ts": "npx tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "yarn test:unit",
    "healthcheck": "sh scripts/docker-healthcheck.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dep-graph": "madge --image dependency-graph.svg --extensions ts,tsx --ts-config tsconfig.json src/",
    "dep-graph:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src/",
    "marp:pdf": "marp presentations/presentation.marp.md --pdf -o presentations/presentation.pdf --allow-local-files",
    "marp:pptx": "marp presentations/presentation.marp.md --pptx -o presentations/presentation.pptx --allow-local-files",
    "marp:html": "marp presentations/presentation.marp.md --html -o presentations/presentation.html --allow-local-files"
  },
