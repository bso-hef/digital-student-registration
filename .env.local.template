# ============================================
# Digital Student Registration
# Local Development Environment Configuration
# ============================================
#
# For localhost/127.0.0.1 development
# No domain or public SSL required
#
# Usage:
#   cp .env.local.template .env.local
#   docker-compose -f docker-compose.local.yml up -d
#   Or use: ./scripts/start-local.sh

# ============================================
# Application Configuration
# ============================================

# Application name
APP_NAME=Digital Student Registration (Local)

# Application version
APP_VERSION=1.0.0-local

# Node environment
NODE_ENV=production

# ============================================
# MongoDB Configuration
# ============================================

# MongoDB username (default for local dev)
MONGO_USER=admin

# MongoDB password (change for security)
MONGO_PASSWORD=admin123

# MongoDB database name
MONGO_DB=digital-student-registration

# ============================================
# Redis Configuration
# ============================================

# Redis password (change for security)
REDIS_PASSWORD=redis123

# ============================================
# NextAuth Configuration
# ============================================

# NextAuth secret for JWT signing
# Auto-generated if not set, or use a custom 64-character string
NEXTAUTH_SECRET=local-dev-secret-change-in-production-min-64-chars-required

# ============================================
# Mongo Express (Database UI)
# ============================================

# Mongo Express password
MONGO_EXPRESS_PASSWORD=admin123

# ============================================
# Notes for Local Development
# ============================================
#
# 1. Access Points:
#    - Application:    https://localhost:3000 or https://localhost
#                      (Browser will show security warning - click "Advanced" and "Proceed")
#    - Mongo Express:  http://localhost:8081 (user: admin, pass: admin123)
#    - MongoDB:        mongodb://admin:admin123@localhost:27017
#    - Redis:          redis://localhost:6379 (password: redis123)
#
# 2. Default Credentials:
#    - MongoDB:        admin / admin123
#    - Redis:          password: redis123
#    - Mongo Express:  admin / admin123
#
# 3. Quick Start:
#    ./scripts/start-local.sh
#
# 4. Stop:
#    docker-compose -f docker-compose.local.yml down
#
# 5. Clean (remove all data):
#    docker-compose -f docker-compose.local.yml down -v
#
# 6. View logs:
#    docker-compose -f docker-compose.local.yml logs -f
#
# 7. Security Note:
#    These are DEVELOPMENT credentials only!
#    Never use these in production!
