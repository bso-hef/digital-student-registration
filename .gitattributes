# Normalize line endings: let Git decide for text, check out native.
* text=auto

# Shell scripts and git hooks must always be LF, even on Windows,
# or they fail to execute.
*.sh             text eol=lf
.husky/*         text eol=lf
scripts/*.sh     text eol=lf

# PowerShell scripts stay CRLF.
*.ps1            text eol=crlf

# Lockfiles and generated assets — treat as binary-ish to reduce diff noise.
yarn.lock        -diff linguist-generated
*.svg            -diff
