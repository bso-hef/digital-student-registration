# Caddyfile for Digital Student Registration
# Production-ready reverse proxy with automatic HTTPS via Let's Encrypt

{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }

    # Compression (gzip and zstd)
    encode {
        gzip 6
        zstd
    }

    # Security headers
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://{$DOMAIN} wss://{$DOMAIN}; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @static {
        path /_next/static/* /images/* /fonts/* /icons/* *.css *.js *.woff *.woff2 *.ttf *.eot *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp
    }

    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @images {
        path /_next/image*
    }

    header @images {
        Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    @api {
        path /api/*
    }

    header @api {
        Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    @health {
        path /api/health/*
    }

    header @health {
        Cache-Control "no-store"
    }

    reverse_proxy app:3000 {
        health_uri /api/health/live
        health_interval 30s
        health_timeout 10s
        health_status 200
        lb_policy least_conn

        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }
    }

    handle_errors {
        @502-504 {
            expression {http.error.status_code} in [502, 503, 504]
        }
        respond @502-504 "Service temporarily unavailable. Please try again later." 503
    }
}
