# =====================================================================
# DOCKER ENVIRONMENT - PRE-CONFIGURED FOR TESTING
# =====================================================================
# This file is committed to git and contains TEST credentials.
#
# ⚠️  WARNING: FOR TESTING ONLY - NOT FOR PRODUCTION USE! ⚠️
#
# This configuration allows testers to run the application with a
# single command: docker compose up -d
#
# For production deployment, use .env.docker.example as a template
# and configure with secure credentials.
# =====================================================================

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
# MongoDB connection string (uses Docker service name 'mongo')
MONGODB_URI=mongodb://admin:test-password-123-NOT-FOR-PRODUCTION@mongo:27017/digital-student-onboarding?authSource=admin

# MongoDB root credentials (used by docker-compose)
MONGO_USER=admin
MONGO_PASSWORD=test-password-123-NOT-FOR-PRODUCTION

# =============================================================================
# NEXTAUTH CONFIGURATION (Authentication)
# =============================================================================
# Application URL
NEXTAUTH_URL=https://localhost:3000

# Secret key for JWT signing (generated for testing - NOT FOR PRODUCTION!)
NEXTAUTH_SECRET=test-secret-wKj9xPzL4mN8qRtY2vB5cD6eF7gH9iJ0kL1mN2oP3qR4sT5uV6wX7yZ8aB9cD0eF1gH2iJ3kL4mN5oP6qR7sT8uV9wX0yZ1

# =============================================================================
# APPLICATION URLs
# =============================================================================
# Public-facing API URL
NEXT_PUBLIC_API_URL=https://localhost:3000

# =============================================================================
# APPLICATION METADATA
# =============================================================================
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_NAME=digital-student-registration

# Package.json variables (for docker-compose substitution)
npm_package_version=1.0.0
npm_package_name=digital-student-registration

# =============================================================================
# MONGO EXPRESS (Development Only - Database Web UI)
# =============================================================================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=pass

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# TESTING CREDENTIALS REFERENCE
# =============================================================================
# MongoDB Database:
#   Host: localhost:27017 (from host machine)
#   Username: admin
#   Password: test-password-123-NOT-FOR-PRODUCTION
#   Database: digital-student-onboarding
#
# Mongo Express Web UI:
#   URL: http://localhost:8081
#   Username: admin
#   Password: pass
#
# Application Admin:
#   First-time setup required at: https://localhost:3000/setup
#   You'll create your admin credentials during setup
#
# ⚠️  SECURITY REMINDER:
# These credentials are intentionally simple for TESTING purposes.
# Never use these values in production environments!
# For production, generate secure random passwords with:
#   openssl rand -base64 32
# =============================================================================
